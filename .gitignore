node_modules/
dist/
*.log
.DS_Store
.omc/
.eval-cache/

# Local agent/tooling state (not part of the project)
.claude/
.sessionlog/
.sudocode/
.vscode/

# LOCOMO extraction cache (WS0)
evals/locomo/.cache/

# LongMemEval dataset cache (277MB, download on demand — see evals/longmemeval/README.md)
evals/longmemeval/cache/
evals/longmemeval/.cache/

# BEAM dataset cache (parquet + normalized JSON, download/convert on demand — see evals/beam/README.md)
evals/beam/cache/
evals/beam/.venv/

# LongMemEval per-run outputs (regenerate via the CLIs; not curated docs)
evals/longmemeval/RESULTS-*.md
evals/longmemeval/DETAILS-*.jsonl
evals/longmemeval/*.pid

# LOCOMO diagnostic checkpoints (transient resume state)
evals/locomo/results/*.ckpt.json

# GateMem per-episode work dirs + per-run outputs (transient; regenerate via eval-domain.tmp.sh)
evals/gatemem/.work*/
evals/gatemem/results/
# Generated from the GateMem checkout, not redistributed here — see run.ts for the command
evals/gatemem/official-prompt.json
# One-off experiment runners; the durable harness is run.ts + eval-domain.tmp.sh + report.tmp.py
evals/gatemem/run-*.tmp.sh
evals/beam/run-*.tmp.sh
evals/locomo/run-*.tmp.sh
